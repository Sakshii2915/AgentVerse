# AgentVerse Environment Configuration

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Search Provider Settings
# Tavily Search API key (primary research provider)
TAVILY_API_KEY=your_tavily_api_key_here
# Alternative search provider fallback: "tavily", "duckduckgo", or "auto"
SEARCH_PROVIDER=auto

# Database Configuration
# Default PostgreSQL URL (for Docker / production)
# For local development without Docker, AgentVerse automatically falls back to sqlite:///./agentverse.db if PostgreSQL is unavailable
DATABASE_URL=postgresql://agentverse:agentverse@localhost:5432/agentverse

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
STREAMLIT_PORT=8501

# Multi-Agent Workflow Parameters
MAX_RESEARCH_ITERATIONS=2
MAX_SOURCES_PER_TOPIC=5
REQUEST_TIMEOUT=30
LOG_LEVEL=INFO
